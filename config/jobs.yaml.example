# pi-cron example config. Copy the jobs you want into
# <data-dir>/config/jobs.yaml (default ~/.local/share/pi-cron/config/jobs.yaml).
# The runner never writes that file — state lives in state/state.db.

defaults:
  timezone: Europe/London          # IANA zone; schedules are wall-clock times here
  overlap: skip
  timeoutMs: 300000
  model: anthropic/claude-sonnet-4-5 # any provider/model your pi is configured for
  thinking: medium
  # Optional lean mode for every llm step: only these extensions load (no
  # discovered extensions/skills/prompt templates). cron-guard enforces a
  # per-step tool policy from <data-dir>/config/cron-guard.json.
  # extensions:
  #   - ~/path/to/pi-cron/extensions/cron-guard.ts

jobs:
  # --- LLM triage: prompt file, high reasoning, read-leaning tools ---
  - id: notes-inbox-triage
    schedule: "0 9 * * *"
    cwd: ~/notes
    promptsDir: prompts/inbox-triage
    enabled: false
    steps:
      - name: triage
        condition: test $(find "$HOME/notes/inbox" -maxdepth 1 -type f -name '*.md' | wc -l) -gt 0
        run: { type: llm, prompt: triage.md, thinking: high, tools: [read, grep, find, ls, edit, write] }
    report: { mode: stdout }

  # --- multi-step with a Monday-only step and a file report sink ---
  - id: morning-brief
    schedule: "45 6 * * *"
    cwd: ~/notes
    promptsDir: prompts/morning-brief
    enabled: false
    steps:
      - name: gather
        run: { type: exec, command: "./scripts/gather.sh {{SCRATCH}}" }
      - name: triage
        run: { type: llm, prompt: triage.md, thinking: high, tools: [read, write] }
      - name: write
        run: { type: llm, prompt: write.md, tools: [read, write] }
      - name: intentions
        condition: test $(date +%u) -eq 1
        run: { type: llm, prompt: intentions.md, tools: [read, write] }
    report: { mode: file-append, path: "~/notes/weeks/{WEEK}.md", marker: "brief-{DATE}" }

  # --- plain script job, quiet ---
  - id: sessions-maintenance
    schedule: "0 3 * * 0"
    enabled: false
    steps:
      - name: main
        run: { type: exec, command: "~/bin/pi-sessions-maintenance.sh" }
    report: { mode: none }

  # --- ephemeral one-shot: fires once at runAt, then auto-disables ---
  # No `schedule` (forbidden with once:true). runAt is absolute ISO with
  # offset/Z. graceMs (default 86400000) bounds late catch-up after downtime;
  # older than grace is marked missed. Manual `--run` does NOT consume it.
  - id: once-example
    description: "Example one-shot (disabled template)"
    once: true
    runAt: "2026-10-02T09:00:00+10:00"
    enabled: false
    steps:
      - name: main
        run: { type: exec, command: "echo one-shot-fired >> /tmp/once-example.log" }
    report: { mode: none }
