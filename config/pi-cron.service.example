[Unit]
Description=pi-cron — always-on scheduler backend for Pi jobs
After=network.target
Documentation=https://github.com/thed24/pi-ui

[Service]
Type=simple
ExecStart=/home/dom/.nvm/versions/node/v24.16.0/bin/node /home/dom/Projects/pi-cron/dist/src/daemon.js
WorkingDirectory=/home/dom/Projects/pi-cron
Environment=PATH=/home/dom/.local/bin:/home/dom/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
StandardOutput=append:/tmp/pi-cron.log
StandardError=append:/tmp/pi-cron.log

[Install]
WantedBy=default.target
