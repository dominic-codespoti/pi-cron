[Unit]
Description=pi-cron — always-on scheduler backend for Pi jobs
After=network.target
Documentation=https://github.com/dominic-codespoti/pi-cron

# Install: copy to ~/.config/systemd/user/pi-cron.service, adjust the node path
# (Node >= 22.5, for node:sqlite) and the checkout path, then
#   systemctl --user daemon-reload && systemctl --user enable --now pi-cron
[Service]
Type=simple
ExecStart=/usr/bin/env node %h/pi-cron/dist/src/daemon.js
WorkingDirectory=%h/pi-cron
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
